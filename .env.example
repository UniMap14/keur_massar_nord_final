# ============================================================
# .env.example — modèle à copier en ".env" (voir .gitignore).
#
#   cp .env.example .env
#
# Ce fichier-modèle, lui, PEUT être committé sur GitHub : il ne
# contient aucun secret réel, seulement la liste des variables
# attendues et des exemples de valeurs.
# ============================================================

# --- Django ---
# Générer une nouvelle clé avec :
#   python -c "import secrets,string; a=string.ascii_letters+string.digits+'!@#%^&*(-_=+)'; print(''.join(secrets.choice(a) for _ in range(64)))"
DJANGO_SECRET_KEY=change-moi-avec-une-vraie-cle-secrete-generee
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# En production, ajouter le(s) domaine(s) réel(s), avec le schéma https:// :
# DJANGO_ALLOWED_HOSTS=keurmassarnord.sn,www.keurmassarnord.sn
# DJANGO_CSRF_TRUSTED_ORIGINS=https://keurmassarnord.sn,https://www.keurmassarnord.sn

# --- Base de données PostgreSQL / PostGIS ---
DB_NAME=keur_massar_nord_arret_003_008_014
DB_USER=postgres
DB_PASSWORD=change-moi
DB_HOST=localhost
DB_PORT=5432

# --- Email ---
# Développement (par défaut si non défini) : les emails s'affichent dans
# la console au lieu d'être envoyés.
# Production (exemple SMTP) :
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=ton.email@gmail.com
# EMAIL_HOST_PASSWORD=ton_mot_de_passe_application
DEFAULT_FROM_EMAIL=contact@keurmassarnord.sn
CONTACT_EMAIL=contact@keurmassarnord.sn

# Adresse(s) recevant les notifications internes (nouveau signalement,
# nouvelle démarche citoyenne). Séparer par des virgules si plusieurs.
# NOTIF_AGENTS_EMAIL=agent1@keurmassarnord.sn,agent2@keurmassarnord.sn

# --- SMS (notifications signalement résolu / démarche mise à jour) ---
SMS_BACKEND=console
# SMS_BACKEND=orange
# SMS_ORANGE_CLIENT_ID=
# SMS_ORANGE_CLIENT_SECRET=
# SMS_ORANGE_SENDER=

# --- Paiement en ligne (Orange Money / Wave) ---
PAIEMENT_BACKEND=manuel
# PAIEMENT_BACKEND=orange_money
# PAIEMENT_BACKEND=wave
# PAIEMENT_ORANGE_MERCHANT_KEY=
# PAIEMENT_ORANGE_CLIENT_ID=
# PAIEMENT_ORANGE_CLIENT_SECRET=
# PAIEMENT_WAVE_API_KEY=